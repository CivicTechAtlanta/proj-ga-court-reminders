TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TEST_NUMBER=18777804236

# Host-side defaults for the court database running in Floci (`make db-url`
# prints the live values). The deployed Lambdas read theirs from Secrets
# Manager instead. The stack works without a .env at all.
COURT_DB_USER=court
COURT_DB_PASSWORD=court
COURT_DB_NAME=courtdb
COURT_DB_PORT=7001

# TrueDialog, the SMS provider. The API key and secret arrive in TrueDialog's
# credentials email; the account id sits next to the account name in the
# TrueDialog portal. Channel 22 is the account's default number, confirmed by
# a real send; change it only for a dedicated long code or short code.
# `make local-deploy` copies these values into the secret the sender Lambda
# reads inside Floci; in AWS the same secret is filled in by hand (README).
TRUEDIALOG_API_KEY=
TRUEDIALOG_API_SECRET=
TRUEDIALOG_ACCOUNT_ID=
TRUEDIALOG_CHANNEL_ID=22
# Phone that receives the integration-test text (unset = no text is sent).
# This reaches the integration tests only. Insomnia and `make local-invoke`
# take the destination from the collection variable or the event file, so
# setting it here does not change where those send.
TRUEDIALOG_TEST_NUMBER=
