# Local development settings. Every script under script/ reads this file, so
# copy it to .env before running any of them: cp .template.env .env
#
# Floci, the local AWS emulator, answers on this endpoint and accepts any
# credentials. Without these four the scripts reach for real AWS and stop
# with "Unable to locate credentials".
#
# Targeting real AWS instead? Do not use .env for that. Unset
# AWS_ENDPOINT_URL and use your configured AWS profile; see the AWS
# deployment section of the README.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Host-side defaults for the court database running in Floci (script/setup
# prints the live values). The deployed Lambdas read theirs from Secrets
# Manager instead.
COURT_DB_USER=court
COURT_DB_PASSWORD=court
COURT_DB_NAME=courtdb
COURT_DB_PORT=7001

# TrueDialog, the SMS provider. The API key and secret arrive in TrueDialog's
# credentials email; the account id sits next to the account name in the
# TrueDialog portal. Channel 22 is the account's default number, confirmed by
# a real send; change it only for a dedicated long code or short code.
# script/setup copies these values into the secret the sender Lambda reads
# inside Floci; in AWS the same secret is filled in by hand (README).
# Additional note: make sure you single quote the api secret if it contains a "$"
TRUEDIALOG_API_KEY=
TRUEDIALOG_API_SECRET=
TRUEDIALOG_ACCOUNT_ID=
TRUEDIALOG_CHANNEL_ID=22
