#!/bin/sh
if [ ! -f .env ]; then
  echo "missing: .env -- create it first with:  cp .template.env .env" >&2
  echo "(run every script from the repository root)" >&2
  exit 1
fi

set -a
. ./.env
set +a

set -e

docker run --rm -it --network court-reminders_default postgres:16-alpine \
		psql "$(uv run --with boto3==1.40.3 python script_helpers/local_db_url.py --docker-network)"