#!/usr/bin/env bash
set -euo pipefail
. script/env

# Runs the seven-day fixture query; expect 13 rows right after a seed.


docker run --rm -i --network court-reminders_default postgres:16-alpine \
		psql "$(uv run --with boto3==1.40.3 python script_helpers/local_db_url.py --docker-network)" \
		-v ON_ERROR_STOP=1 < db/queries/next_week_hearings.sql