#!/bin/sh
set -e

if [ ! -f .env ]; then
  echo "missing: .env -- create it first with:  cp .template.env .env" >&2
  echo "(run every script from the repository root)" >&2
  exit 1
fi

set -a
. ./.env
set +a


uv run cdk synth CourtReminderStack
uv run --with boto3==1.40.3 python script_helpers/local_cdk_deploy.py