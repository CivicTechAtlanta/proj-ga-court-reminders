#!/bin/sh
if [ ! -f .env ]; then
  echo "missing: .env -- create it first with:  cp .template.env .env" >&2
  echo "(run every script from the repository root)" >&2
  exit 1
fi

set -a
. ./.env
set +a

set -e

docker compose stop floci
uv run python script_helpers/local_cleanup.py --volumes
docker compose down --volumes --remove-orphans


./script/setup