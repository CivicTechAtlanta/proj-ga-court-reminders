#!/usr/bin/env bash
set -euo pipefail

if [ ! -f .env ]; then
  echo "missing: .env -- create it first with:  cp .template.env .env" >&2
  echo "(run every script from the repository root)" >&2
  exit 1
fi

set -a
. ./.env
set +a

SEND_MESSAGE_FLAG=
if [[ -n ${1-} ]]; then SEND_MESSAGE_FLAG="--send $1"; fi;

uv run python script_helpers/truedialog_check.py $SEND_MESSAGE_FLAG 
